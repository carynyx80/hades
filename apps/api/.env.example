# Port is set by Railway automatically
CORS_ORIGIN=*
# Optional: provider RPCs (public ones are rate limited)
BSC_TESTNET_RPC=
ROBINHOOD_TESTNET_RPC=
# Pyth Hermes key (needed for on-chain settlement with Pyth; display prices fall back to Kraken/Coinbase/CoinGecko)
HERMES_API_KEY=
# After deploying contracts, paste contracts/deployments/<chainId>.json as one line
DEPLOYMENT_97=
DEPLOYMENT_46630=
# Hot wallets with gas only (never the admin key)
KEEPER_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=
